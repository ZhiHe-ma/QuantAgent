{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZhiHe-ma/QuantAgent/schemas/quantagent.run_status.v2.schema.json",
  "title": "QuantAgent Local Task Status v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type", "run_id", "status", "cancel_requested", "created_at",
    "started_at", "completed_at", "failure_type", "links"
  ],
  "properties": {
    "contract_type": { "const": "quantagent.run_status.v2" },
    "run_id": { "type": "string", "pattern": "^task-[a-f0-9]{32}$" },
    "status": {
      "enum": ["queued", "running", "completed", "failed", "cancelled", "interrupted"]
    },
    "cancel_requested": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "failure_type": { "type": ["string", "null"] },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "report"],
      "properties": {
        "summary": { "type": ["string", "null"], "pattern": "^/api/v1/runs/task-[a-f0-9]{32}$" },
        "report": { "type": ["string", "null"], "pattern": "^/api/v1/runs/task-[a-f0-9]{32}/report$" }
      }
    }
  }
}
